# OpenAI — AI 판단(구조화 출력)과 뉴스 감성(web_search)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-sol
# low | medium | high
OPENAI_REASONING_EFFORT=low
# 엔진 한 주기에 OpenAI 를 부르는 최대 횟수 (넘으면 규칙 기반 설명으로 대체)
OPENAI_MAX_CALLS_PER_TICK=3

# 키움증권 REST API — 모의투자와 실전은 앱키가 다릅니다.
# mock = https://mockapi.kiwoom.com (모의투자), real = https://api.kiwoom.com (실전)
KIWOOM_MODE=mock
KIWOOM_MOCK_APP_KEY=
KIWOOM_MOCK_SECRET_KEY=
KIWOOM_APP_KEY=
KIWOOM_SECRET_KEY=
# 초당 요청 수 상한 (유량 초과 1700 오류 방지)
KIWOOM_MAX_RPS=4

# auto = 키움 키가 있으면 키움, 없으면 로컬 시뮬레이션 / kiwoom / simulated
DATA_SOURCE=auto

# 엔진 주기(초)와 승인 대기 시간(초)
ENGINE_INTERVAL_SECONDS=60
APPROVAL_TIMEOUT_SECONDS=300
# 실전 계좌(KIWOOM_MODE=real)에서 실전 주문을 허용하기 전 필요한 운영 일수
PAPER_DAYS_BEFORE_LIVE=14
